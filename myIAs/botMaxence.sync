/**
 * @presentation : 
 *
 * IA « BotMaxence » pour Roll For The Milkyway
 *
 * Cette IA a pour objectif de maximiser le score de manière stratégique.
 *
 * Approche principale :
 * 
 *   Mon avis est est que les dés partager sont beaucoup trop instable et aléatoire comme ils sont manipuler par tout les joueurs.
     -> J'ai donc décider de baser mon algorithmes sur les dés du joueur seulement.
 * 
 *   Le but de mon algo est d'alors trouver les meilleurs mouvement afin d'atteindre l'objectif le plus proche.
 *   Ensuite on cherche alors quelle est le meilleur dé partager à bouger afin de soutenir l'objectif visé par les dée du joueur.
 * 
 *   L'objectif choisi est toujours celui qui est le plus proche à atteindre. Si des objectifs sont tout aussi proche à atteindre,
 *   Alors l'objectif le plus difficile sera choisi.
 * 
 * Résumé de l'approche : 
 * 
 * - L'IA base ses décisions sur les dés personnels du joueur.
 * - Les dés partagés sont considérés comme un soutien potentiel mais
 *   ne sont pas contrôlables directement, donc leur rôle est secondaire.
 * - Pour chaque objectif non encore revendiqué, l'IA calcule les mouvements
 *   optimaux des dés personnels pour se rapprocher des conditions nécessaires.
 * - Les mouvements sont simulés avant d'être appliqués pour choisir l'action
 *   la plus efficace.
 *
 * Stratégie de revendication :
 * - L'IA revendique l'objectif le plus difficile disponible parmi ceux
 *   atteignables, afin de maximiser les points.
 *
 * Fonctionnement général :
 * 1) Initialisation des structures (joueurs, dés, objectifs).
 * 2) Mise à jour des données à chaque tour.
 * 3) Calcul des meilleurs mouvements pour les dés du joueur.
 * 4) Simulation et application des mouvements.
 * 5) Vérification et revendication des objectifs atteignables.
 *
 * Outils utilisés :
 * - CHAT-GPT utilisé pour générer quelques fonction de debug.
 *   Tous les algorithmes sont conçus et développé par l'auteur.
 * - color-syntax : https://github.com/LePeruvienn/roll_for_the_milkyway/tree/main/color-syntax
 */


/**
----------------------------------
           GLOBALS
----------------------------------
*/

GLOBALS

	// Enum values for elements

	enum_pe = 0 // PE element
	enum_h3 = 1 // H3 element
	enum_am = 2 // AM element
	enum_mn = 3 // MN element

	// constants

	cst_nb_objectives = 9 // {int} amount of objectives in the game
	cst_nb_dices = 4      // {int} amount of dices of shared_dices and also each player dices
	cst_nb_moves = 8      // {int} amount of moves allowed each turn
	cst_nb_elements = 4   // {int} amount of elements is in the game (can be used to go throught enum)

	cst_infinite = -9999  // {int} represent the infinity (used with unsigned int values only)

	// globas vars, setted up at game initialization (init FUNCTION)

	nb_exp = NULL       // {int}              number of player (explorers) in the game
	num_exp = NULL      // {int}              explorer ID that we are playing
	players = NULL      // {player_data**}    array of all the players in the game
	objectives = NULL   // {objective_data**} array of all the objectives in the game
	shared_dices = NULL // {dice_data**}      array of all the shared dices

ENDGLOBALS


/**
----------------------------------
           STRUCTURES
----------------------------------
*/

/**
 * Represent a player in the game
 * IMPORTANT: use the `create_player` function to create a new player data structure ptr
 */
STRUCT player_data

	pid     // {int}         player unique ID given at the start of the game (default value is -1, wich mean the value has not been set)
	is_dead // {bool}        player death status (TRUE: player is dead | FALSE: player alive, FALSE by default)
	score   // {int}         player current score (0 by default)
	dices   // {dice_data**} list of player's dices, the size of the array is 4 (cst_nb_dices), the value is a NULL ptr by default.

ENDSTRUCT

/**
 * Represent a objective in the game
 * IMPORTANT: use the `create_objective` function to create a new objective data structure ptr
 */
STRUCT objective_data

	oid        // {int}  objective unique ID given at the start of the game (default value is -1, wich mean it has not been set)
	nb_fpe     // {int}  number of PE elments needed to complete the objective (0 by default)
	nb_fh3     // {int}  number of H3 elments needed to complete the objective (0 by default)
	nb_fam     // {int}  number of AM elments needed to complete the objective (0 by default)
	nb_fmn     // {int}  number of MN elments needed to complete the objective (0 by default)
	is_claimed // {bool} objective claimedd status (TRUE: objective has been already claimed | FALSE: objective not claimed yet)

ENDSTRUCT

/**
 * Represent a dice in the game
 * IMPORTANT: use the `create_dice` function to create a new dice data structure ptr
 */
STRUCT dice_data

	index  // {int}  current dice's face active, 0 by default
	faces  // {int*} array of integer representing the faces, each value is one of the enum elements (enum_pe | enum_h3 | enum_am | enum_mn), NULL ptr by default
	length // {int}  number of faces the dice have (size of the `faces` array), 0 by default

ENDSTRUCT

/**
 * Reprent the data of moves on a list of dices (4 dices).
 * Used to get the best moves to do on a set of dices to achieve an objective.
 * IMPORTANT: use the `create_dices_moves` function to create a new dice data structure ptr
 */
STRUCT dices_moves_data

	targeted_objective // {objective_data*} the targeted objective when performing these moves, by default NULL
	total_moves_amount // {int}             the total number of moves to reach the objective (or to be the closest to), default cst_infinite
	moves_by_dice      // {int*}            the moves by dice to do (the index is the dice index so, and the value is the moves to apply on the dices),
	                   //                   default array of int* of size cst_nb_dices filled with zeros

ENDSTRUCT

/**
----------------------------------
           DEBUG
----------------------------------
*/

/**
 * Prints a `dices_moves_data` structur in stderr
 * @param {dices_moves_data*} data
 */
FUNCTION print_dices_moves(data)

	// check if ptr is null
	IF(data == NULL)
		PRINTERR("DICES_MOVES_DATA = NULL\n")

	// If not null print his data
	ELSE
		PRINTERR("DICES_MOVES_DATA {\n")
		
		// targeted objective
		IF(data->targeted_objective == NULL)
			PRINTERR("  targeted_objective: NULL,\n")
		ELSE
			PRINTERR("  target_oid: ", INT, data->targeted_objective->oid, ",\n")
		ENDIF
		
		// moves amount
		IF(data->total_moves_amount == cst_infinite)
			PRINTERR("  total_moves: INFINITE,\n")
		ELSE
			PRINTERR("  total_moves: ", INT, data->total_moves_amount, ",\n")
		ENDIF

		// moves by dice array
		PRINTERR("  moves_by_dice: [")
		FOR(i; 0; cst_nb_dices)

			PRINTERR(INT, data->moves_by_dice[i])
			IF(i < cst_nb_dices - 1)
				PRINTERR(", ")
			ENDIF

		ENDFOR

		PRINTERR("]\n")
		PRINTERR("}\n")
	ENDIF

END

/**
 * Prints a `objective_data` structur in stderr
 * @param {objective_data*} data
 */
FUNCTION print_objective(objective)

	// check if ptr is null
	IF(objective == NULL)
		PRINTERR("OBJECTIVE = NULL\n")
	// if not print his data
	ELSE
		PRINTERR("OBJECTIVE {\n")
		PRINTERR("oid: ", INT, objective->oid, ",\n")
		PRINTERR("nb_fpe: ", INT, objective->nb_fpe, ",\n")
		PRINTERR("nb_fh3: ", INT, objective->nb_fh3, ",\n")
		PRINTERR("nb_fam: ", INT, objective->nb_fam, ",\n")
		PRINTERR("nb_fmn: ", INT, objective->nb_fmn, ",\n")
		PRINTERR("is_claimed: ", INT, objective->is_claimed, ",\n")
		PRINTERR("}\n")
	ENDIF
END

/**
 * Prints a `dice_data` structur in stderr
 * @param {dice_data*} data
 */
FUNCTION print_dice(dice)

	// check if ptr is null
	IF(dice == NULL)
		PRINTERR("DICE = NULL\n")
	// if not print his data
	ELSE
		PRINTERR("DICE index=", INT, dice->index, " faces=[")
		FOR(i;0;dice->length)
			PRINTERR(INT, dice->faces[i])
			IF(i < dice->length - 1)
				PRINTERR(",")
			ENDIF
		ENDFOR
		PRINTERR("]\n")
	ENDIF

END

/**
 * Prints a `dice_data*` array in stderr
 * @param {dice_data**} dices
 */
FUNCTION print_dices(dices)

	FOR(i;0;cst_nb_dices)
		print_dice(dices[i])
	ENDFOR

END

/**
----------------------------------
           FONCTIONS
----------------------------------
*/

// -- COPY FUNCTIONS --

/**
 * copy `dices_moves_data*` source data into an other ptr.
 * it does not allocate a new structure in memory !
 * @param {dices_moves_data*} source
 * @param {dices_moves_data*} dest
 */
FUNCTION copy_dices_moves_data(source, dest)

	dest->targeted_objective = source->targeted_objective
	dest->total_moves_amount = source->total_moves_amount
	
	FOR(i;0;cst_nb_dices)
		dest->moves_by_dice[i] = source->moves_by_dice[i]
	ENDFOR

END

/**
 * copy `objective_data*` source data into an other ptr.
 * it does not allocate a new structure in memory !
 * @param {dices_moves_data*} source
 * @param {dices_moves_data*} dest
 */
FUNCTION copy_objective_data(source, dest)

	dest->oid = source->oid
	dest->nb_fpe = source->nb_fpe
	dest->nb_fh3 = source->nb_fh3
	dest->nb_fam = source->nb_fam
	dest->nb_fmn = source->nb_fmn
	dest->is_claimed = source->is_claimed

END

// -- RESET FUNCTIONS --

/**
 * Reset `dices_moves_data` structure data to default.
 * @param {dices_moves_data*} data
 */
FUNCTION reset_dices_moves_data(data)
	
	data->targeted_objective = NULL
	data->total_moves_amount = cst_infinite

	FOR(i;0;cst_nb_dices)
		data->moves_by_dice[i] = 0
	ENDFOR

END


// -- CREATE FUNCTIONS --

/**
 * `objective_data` constructor
 */
FUNCTION create_objective()

	// malloc structure
	objective = MALLOC_STRUCT(objective_data)

	// setting up default values
	objective->oid = -1
	objective->nb_fpe = 0
	objective->nb_fh3 = 0
	objective->nb_fam = 0
	objective->nb_fmn = 0
	objective->is_claimed = FALSE

	// returning structure ptr
	RETURN objective
	
END

/**
 * `objective_data` copy constructor
 *  create a new struct ptr with the source values
 */
FUNCTION create_objective_copy(source)

	// create a new object
	objective = create_objective() 
	// coopy source data into it
	copy_objective_data(source, objective)
	// returning ptr
	RETURN objective
	
END

/**
 * `dice_data` constructor
 */
FUNCTION create_dice()

	// malloc structure
	dice = MALLOC_STRUCT(dice_data)

	// default data values
	dice->index = 0
	dice->length = 0
	dice->faces = NULL

	// returning structure ptr
	RETURN dice 

END

/**
 * Create a `dice_data*` array,
 * and fills the dices faces with the values values of **players dices**.
 */
FUNCTION create_player_dices()

	// malloc a new `dice_data*` array
	dices = MALLOC(cst_nb_dices)

	// fills the array with new dice_data
	FOR(i;0;cst_nb_dices)
		dices[i] = create_dice()
	ENDFOR

	// getting dices ptr
	d5 = dices[0]
	d6 = dices[1]
	d7 = dices[2]
	d8 = dices[3]

	// setting up there length
	d5->length = 5
	d6->length = 6
	d7->length = 5
	d8->length = 6

	// malloc dices faces array
	FOR(i;0;cst_nb_dices)
		dices[i]->faces = MALLOC(dices[i]->length)
	ENDFOR

	// fillings up dices faces with there default values
	d5->faces[0] = enum_pe
	d5->faces[1] = enum_pe
	d5->faces[2] = enum_h3
	d5->faces[3] = enum_h3
	d5->faces[4] = enum_pe

	d6->faces[0] = enum_pe
	d6->faces[1] = enum_h3
	d6->faces[2] = enum_h3
	d6->faces[3] = enum_am
	d6->faces[4] = enum_h3
	d6->faces[5] = enum_h3

	d7->faces[0] = enum_pe
	d7->faces[1] = enum_h3
	d7->faces[2] = enum_am
	d7->faces[3] = enum_am
	d7->faces[4] = enum_h3

	d8->faces[0] = enum_pe
	d8->faces[1] = enum_am
	d8->faces[2] = enum_h3
	d8->faces[3] = enum_mn
	d8->faces[4] = enum_am
	d8->faces[5] = enum_h3

	// returning dices array ptr
	RETURN dices
END

/**
 * Create a `dice_data*` array,
 * and fills the dices faces with the values values of **shared dices**.
 */
FUNCTION create_shared_dices()

	// malloc of the `dice_data*` array
	dices = MALLOC(cst_nb_dices)

	// filling up array with new dices and setting up there length & faces
	FOR(i;0;cst_nb_dices)
		dices[i] = create_dice()
		dices[i]->length = 4
		dices[i]->faces = MALLOC(4)
	ENDFOR

	// get dices references
	d1 = dices[0]
	d2 = dices[1]
	d3 = dices[2]
	d4 = dices[3]

	// filling up dices faces data
	d1->faces[0] = enum_pe
	d1->faces[1] = enum_am
	d1->faces[2] = enum_mn
	d1->faces[3] = enum_am

	d2->faces[0] = enum_pe
	d2->faces[1] = enum_h3
	d2->faces[2] = enum_mn
	d2->faces[3] = enum_h3

	d3->faces[0] = enum_pe
	d3->faces[1] = enum_h3
	d3->faces[2] = enum_mn
	d3->faces[3] = enum_am

	d4->faces[0] = enum_h3
	d4->faces[1] = enum_mn
	d4->faces[2] = enum_am
	d4->faces[3] = enum_mn

	// retruning dices array ptr
	RETURN dices
END

/**
 * `player_data` constructor
 */
FUNCTION create_player()

	// malloc struct
	player = MALLOC_STRUCT(player_data)

	// setting up default values
	player->pid = -1
	player->is_dead = FALSE
	player->score = 0
	player->dices = create_player_dices()

	// returning structure ptr
	RETURN player

END

/**
 * `dices_moves_data` constructor
 */
FUNCTION create_dices_moves()

	// malloc struct
	dices_moves = MALLOC_STRUCT(dices_moves_data)

	// set default values
	dices_moves->targeted_objective = NULL
	dices_moves->total_moves_amount = cst_infinite
	dices_moves->moves_by_dice = MALLOC(cst_nb_dices)

	// file the moves_by_dice array with zeros
	FOR(i;0;cst_nb_dices)
		dices_moves->moves_by_dice[i] = 0
	ENDFOR

	// return struct ptr
	RETURN dices_moves
END

/**
 * create a new array that is a copy of the source array
 * @param {void*} array
 * @param {int} size
 */
FUNCTION create_array_copy(array, size)

	// malloc of new array
	new_array = MALLOC(size)

	// copy values into the new array
	FOR(i;0;size)
		new_array[i] = array[i]
	ENDFOR

	// return ptr
	RETURN new_array
	
END

// --- DESTROY FUNCTIONS ---

/**
 * `dices_moves_data` destructor
 */
FUNCTION destroy_dices_moves_data(dices_moves)

	FREE(dices_moves->moves_by_dice)
	FREE(dices_moves)

END

// --- INIT FUNCTIONS ---

/**
 * initilize the `players` global variable array,
 * by filling it up with `player_data*` structures
 */
FUNCTION init_players()
	
	// malloc the `player_data*` array by the number of current players
	players = MALLOC(nb_exp)

	// create new players for each ptr in the array
	FOR(i;0;nb_exp)
		players[i] = create_player()
	ENDFOR

END

/**
 * initilize the `objectives` global variable array,
 * by filling it up with `objective_data*` structures
 */
FUNCTION init_objectives()

	// malloc of the `objective_data*` array
	objectives = MALLOC(cst_nb_objectives)

	// create a new objective for each ptr
	FOR(i;0;cst_nb_objectives)
		objectives[i] = create_objective()
	ENDFOR

END

/**
 * GLOBAL GAME INITIALIZATION,
 * this function is called at the start of each game to read input and setting up the game
 */
FUNCTION init()

	// Read inputs or number of players & wich player we are
	nb_exp = READ()
	num_exp = READ()
	
	// initialization of players and objectives
	init_players()
	init_objectives()

	// create shared_dices data
	shared_dices = create_shared_dices()
END


// --- UPDATE FUNCTIONS ---

/**
 * Each **turn** we update the players data,
 * we read the values given by the game to update our `players` array
 */
FUNCTION update_players()

	// Update players array
	FOR(i;0;nb_exp)

		// read given datas
		e = READ()
		p = READ()
		s = READ()

		// compute player index in the array & get player
		p_index = e - 1
		player = players[p_index]

		// update player datas
		player->pid = e
		player->is_dead = p
		player->score = s
		
	ENDFOR

END

/**
 * Each **round** we update the objectives data,
 * we read the values given by the game to update our `objectives` array
 *
 * This update is not meant to update the current objectives data,
 * but to reset the array by overwritting the current data with the new objectives given
 */
FUNCTION update_objectives()


	// Update objectives array
	FOR(i;0;cst_nb_objectives)

		// read given datas
		oid = READ()
		fpe = READ()
		fh3 = READ()
		fam = READ()
		fmn = READ()

		objective = objectives[i]

		// set new data
		objective->oid = oid
		objective->nb_fpe = fpe
		objective->nb_fh3 = fh3
		objective->nb_fam = fam
		objective->nb_fmn = fmn
		objective->is_claimed = FALSE
		
	ENDFOR
END

/**
 * Each **turn** we update the shared dices array but all each player dices array,
 * To do so we read each data (moves made by the players) to update ours dices.
 */
FUNCTION update_dices()

	// for each player in game we read his moves
	FOR(i;0;nb_exp)

		// read given datas
		e = READ()
		m1 = READ()
		m2 = READ()
		m3 = READ()
		m4 = READ()
		m5 = READ()
		m6 = READ()
		m7 = READ()
		m8 = READ()

		// update shared_dices
		shared_dices[0]->index = (shared_dices[0]->index + m1 + shared_dices[0]->length) % shared_dices[0]->length
		shared_dices[1]->index = (shared_dices[1]->index + m2 + shared_dices[1]->length) % shared_dices[1]->length
		shared_dices[2]->index = (shared_dices[2]->index + m3 + shared_dices[2]->length) % shared_dices[2]->length
		shared_dices[3]->index = (shared_dices[3]->index + m4 + shared_dices[3]->length) % shared_dices[3]->length

		// update current player dices
		player = players[e - 1]
		player->dices[0]->index = (player->dices[0]->index + m5 + player->dices[0]->length) % player->dices[0]->length
		player->dices[1]->index = (player->dices[1]->index + m6 + player->dices[1]->length) % player->dices[1]->length
		player->dices[2]->index = (player->dices[2]->index + m7 + player->dices[2]->length) % player->dices[2]->length
		player->dices[3]->index = (player->dices[3]->index + m8 + player->dices[3]->length) % player->dices[3]->length

	ENDFOR

END

/**
 * Update the score of all the players
 * We read the data of all the players claim's, and if they are valid we update the score
 */
FUNCTION update_scores()
	
	// for each player in game
	FOR(i;0;nb_exp)

		// read given datas
		e = READ()
		oid = READ()

		// get player data of the current player
		player = players[e - 1]

		// find the targeted objective, and if so check if claimed and if not update objective
		FOR (j;0;cst_nb_objectives)

			objective = objectives[j]

			// if not targeted objective, go to the next one
			IF(objective->oid != oid)
				CONTINUE
			ENDIF

			// if objective is not claimed
			IF(objective->is_claimed == FALSE)

				// set objective to claimed
				objective->is_claimed = TRUE

				// update score depending of objective difficulty
				IF(oid < 11)
					player->score = player->score + 100
				ELIF(oid < 21)
					player->score = player->score + 150
				ELSE
					player->score = player->score + 200

				ENDIF

			ENDIF
			
			// go to next player
			BREAK

		ENDFOR
	
	ENDFOR

END

// -- OBJECTIVES FUNCTIONS

/**
 * Check if an objective can be claimed by **US** (they explorer we are controlling)
 * @param {objective_data*} objective
 * @return {bool}
 */
FUNCTION can_be_claimed(objective)

	// setting up elements counters
	nb_fpe = 0
	nb_fh3 = 0
	nb_fam = 0
	nb_fmn = 0

	// count the number of elements is shared dices

	FOR(i;0;cst_nb_dices)
	
		dice = shared_dices[i]
		index = dice->index
		faces = dice->faces
		
		IF(faces[index] == enum_pe)
			nb_fpe = nb_fpe + 1

		ELIF(faces[index] == enum_h3)
			nb_fh3 = nb_fh3 + 1

		ELIF(faces[index] == enum_am)
			nb_fam = nb_fam + 1

		ELIF(faces[index] == enum_mn)
			nb_fmn = nb_fmn + 1

		ENDIF

	ENDFOR
		
	// count the number of elements is player dices
	player = players[num_exp - 1]

	FOR(i;0;cst_nb_dices)
	
		dice = player->dices[i]
		index = dice->index
		faces = dice->faces
		
		IF(faces[index] == enum_pe)
			nb_fpe = nb_fpe + 1

		ELIF(faces[index] == enum_h3)
			nb_fh3 = nb_fh3 + 1

		ELIF(faces[index] == enum_am)
			nb_fam = nb_fam + 1

		ELIF(faces[index] == enum_mn)
			nb_fmn = nb_fmn + 1

		ENDIF

	ENDFOR

	// return the result
	RETURN (nb_fpe >= objective->nb_fpe AND nb_fh3 >= objective->nb_fh3 AND nb_fam >= objective->nb_fam AND nb_fmn >= objective->nb_fmn)

END

/**
 * Set the `dices_moves_data` ptr with the best amount of moves and the move data to reach the objective in param.
 * The goal of the functions is to find in the list of dices what are the best moves to be the closest to the objective in param.
 *
 * And the end of the function the best moves are set into dices_moves ptr.
 *
 * @param {objective_data*} objective
 * @param {dice_data**} dices_array
 * @param {dices_moves_data*} dices_moves
 */
FUNCTION get_best_dices_moves_for(objective, dices_array, dices_moves)

	// set targeted_objective to objective
	dices_moves->targeted_objective = objective

	// copy objective data into a array of elements
	nb_felems_needed = MALLOC(cst_nb_elements)
	nb_felems_needed[enum_pe] = objective->nb_fpe
	nb_felems_needed[enum_h3] = objective->nb_fh3
	nb_felems_needed[enum_am] = objective->nb_fam
	nb_felems_needed[enum_mn] = objective->nb_fmn

	// copy dices array
	dices = create_array_copy(dices_array, cst_nb_dices)
	dices_left_amount = cst_nb_dices

	// to prevent infinite loop (if all avaible dices cant reach OR have already reached the current objective)
	// Element are considererd colmpleted if :
	// - we already have completed the element amount neeeded.
	// - no avaible dice can reach the element
	element_completed_amount = 0

	// check if objective is reached
	is_objective_reached = FALSE

	// We keep try finding solution until :
	// - we have no dices avaible left
	// - we reached the objective
	// - all element are completed (cannot be reachable or are already filled their nb element needed)
	WHILE(dices_left_amount > 0 AND is_objective_reached == FALSE AND element_completed_amount < cst_nb_elements)

		// reset element_completed_amount value
		element_completed_amount = 0

		// go trought all elements
		FOR(elem;0;cst_nb_elements)

			// Get current of faces needed for the element
			nb_faces_needed = nb_felems_needed[elem]

			// If there is no faces needed go to next element
			IF(nb_faces_needed == 0)
				// Add this to computed element amount (it's used to prenvent infinite loops)
				element_completed_amount = element_completed_amount + 1
				CONTINUE
			ENDIF
			
			// initilize best dice research, setting up first dice as the current best choice
			best_dice_index = -1
			best_dice_distance = cst_infinite
			
			// try to find best dice to use to reach the objective
			FOR(i;0;cst_nb_dices)

				dice = dices[i]

				// If dice is NULL go to the next one
				IF(dice == NULL)
					CONTINUE
				ENDIF
				
				distance = get_dice_distance_from(dices[i], elem)

				// if distance is infinite go to next dice
				IF(distance == cst_infinite)
					CONTINUE
				ENDIF

				// if distance is better than current best distance, set it as best distance
				IF(IABS(distance) < IABS(best_dice_distance) OR best_dice_distance == cst_infinite)
					best_dice_distance = distance
					best_dice_index = i
				ENDIF

			ENDFOR

			// If there is no best choice, go to next dice
			IF(best_dice_index == -1 OR best_dice_distance == cst_infinite)
				// Add this to computed element amount (it's used to prenvent infinite loops)
				element_completed_amount = element_completed_amount + 1
				CONTINUE
			ENDIF

			// setting the dice has taken
			dices[best_dice_index] = NULL
			dices_left_amount = dices_left_amount - 1
			
			// Remove 1 from nb faces element needed array of the current element
			nb_felems_needed[elem] = nb_faces_needed - 1

			// by default total_moves_amount is infinite, if we want to add value we must ensure that it start at 0
			IF(dices_moves->total_moves_amount == cst_infinite)
				dices_moves->total_moves_amount = 0
			ENDIF

			// update result structure dices_moves total_moves_amount & moves_by_dice
			// - the `total_moves_amount` is stricly positive
			// - bu the `moves_by_dice` data can be negative if the moves must go negative
			dices_moves->total_moves_amount = dices_moves->total_moves_amount + IABS(best_dice_distance)
			dices_moves->moves_by_dice[best_dice_index] = dices_moves->moves_by_dice[best_dice_index] + best_dice_distance

		ENDFOR

		// check if current objective is reached
		// The objective is considererd reached if all elements have reached their nb needed
		is_objective_reached = (nb_felems_needed[enum_pe] == 0 AND nb_felems_needed[enum_h3] == 0 AND nb_felems_needed[enum_am] == 0 AND nb_felems_needed[enum_mn] == 0)

	ENDWHILE

	FREE(nb_felems_needed)
	FREE(dices)
	
END

/**
 * Get the distance of dice to move towards an element,
 * it's the amount of movement a dice have to make to reach an element
 * @param {dice_data*} dice
 * @param {int} element (element enum : enum_pe | enum_h3 | enum_am | enum_mn)
 * @return {int}
 */
FUNCTION get_dice_distance_from(dice, element)
	
	// copy current index
	index = dice->index

	// initialize amount (if not reachable it's infinite)
	moves_amount = cst_infinite

	// check each face of the dice
	FOR(i;0;dice->length)

		// compute index
		index = (dice->index + i + dice->length) % dice->length

		// if it's not the element we are looking for, go next
		IF(dice->faces[index] != element)
			CONTINUE
		ENDIF

		// save current_moves_amount
		current_moves_amount = i

		// If it can be reached faster by going backwards, re computed moves amount
		IF(i > dice->length / 2)
			current_moves_amount = i - dice->length
		ENDIF

		// compare current and saves the less moves to reach the objective
		IF(IABS(current_moves_amount) < IABS(moves_amount))
			moves_amount = current_moves_amount
		ENDIF

	ENDFOR
	
	RETURN moves_amount

END

/**
 * The goal of this function is to find the best dices moves to do in the current turn.
 *
 * - First we compute the best dices moves to reach each objective in this turn.
 * - We keep the objective that requieres the less dices moves to be reached
 * - We return the dices moves linked to that objective
 *
 * @param {dice_data**} dices
 */
FUNCTION get_best_dices_moves(dices)

	// This ptr stores the best dices moves of all objective
	best_dices_moves = create_dices_moves()

	// This ptr stores the result of the current objective
	dices_moves_temp = create_dices_moves()

	FOR(i;0;cst_nb_objectives)

		IF(objectives[i]->is_claimed == TRUE)
			CONTINUE
		ENDIF

		// reset temp data
		reset_dices_moves_data(dices_moves_temp)
		
		// Get the best_dices_moves for the current objective
		get_best_dices_moves_for(objectives[i], dices, dices_moves_temp)

		best_total = best_dices_moves->total_moves_amount 
		total = dices_moves_temp->total_moves_amount

		// if current total is infinite go to next one
		IF(total == cst_infinite)
			CONTINUE
		ENDIF

		// if current total is more than best total, go to next one
		IF(total > best_total AND best_total != cst_infinite)
			CONTINUE
		ENDIF

		best_objective = best_dices_moves->targeted_objective
		objective = dices_moves_temp->targeted_objective

		// if total and best_total are equal but best_total has a bigger oid, we keep best_total, go to the next one
		IF (total == best_total AND best_objective->oid > objective->oid AND best_total != cst_infinite)
			CONTINUE
		ENDIF

		// If we pass all the test we keep the currenet dices moves
		// To do so i copy the data from the temp and set it to the best one
		// - this way if i free temp, they would have no impact in the best one
		copy_dices_moves_data(dices_moves_temp, best_dices_moves)

	ENDFOR

	// free temp structure
	destroy_dices_moves_data(dices_moves_temp)

	// returning best dices moves ptr
	RETURN best_dices_moves
END

/**
 * This function is used to simulate the dices moves on a targeted_objective
 * It modify the targeted_objective nb element value to get a new objective,
 * that is the nb elements left after the dices are moven.
 * 
 * @param {objective_data*} targeted_objective
 * @param {int*} moves_by_dice
 * @param {dice_data**} dices
 */
FUNCTION apply_moves_on(targeted_objective, moves_by_dice, dices)

	// For each dices we apply the moves linked to it
	FOR(i;0;cst_nb_dices)

		// get dices data
		dice = dices[i]
		index = dice->index
		faces = dice->faces
		length = dice->length
		move = moves_by_dice[i]

		// get new index after move, and get the new linked element
		new_index = (index + move + length) % length
		elem = faces[new_index]

		// remove 1 from the nb element needed of the objective
		IF(elem == enum_pe AND targeted_objective->nb_fpe > 0)
			targeted_objective->nb_fpe = targeted_objective->nb_fpe - 1
		ELIF(elem == enum_h3 AND targeted_objective->nb_fh3 > 0)
			targeted_objective->nb_fh3 = targeted_objective->nb_fh3 - 1
		ELIF(elem == enum_am AND targeted_objective->nb_fam > 0)
			targeted_objective->nb_fam = targeted_objective->nb_fam - 1
		ELIF(elem == enum_mn AND targeted_objective->nb_fmn > 0)
			targeted_objective->nb_fmn = targeted_objective->nb_fmn - 1
		ENDIF

	ENDFOR
	
END

// --- MAKE FUNCTIONS ---

/**
 * This function print the moves given in param.
 * First it make the shared dices moves and the the player dices.
 * 
 * @param {dices_moves_data*} best_shared_dices_moves
 * @param {dices_moves_data*} best_player_dices_moves
 */
FUNCTION make_moves(best_shared_dices_moves, best_player_dices_moves)

	// get moves_by_dice data from best_shared_dices_moves
	moves_by_dice = best_shared_dices_moves->moves_by_dice

	// value to see if we already made a move on shared dices
	// (we cant do more than 1 moves on the shared dices)
	made_move = FALSE

	// for each move
	FOR(i;0;cst_nb_dices)

		move_value = moves_by_dice[i]
		
		// if move value is 0 or we already made a move dont move this dice
		IF(move_value == 0 OR made_move == TRUE)
			PRINT("MOVE 0")
		// else we make the dice move by the value given & set made_move to TRUE
		// (it's either 1 or -1 depending of the move value sign, no other move value is allowed in the game)
		ELIF(move_value > 0)
			PRINT("MOVE 1")
			made_move = TRUE
		ELSE
			PRINT("MOVE -1")
			made_move = TRUE
		ENDIF

	ENDFOR
	
	// get moves_by_dice data from player_shared_dices_moves
	moves_by_dice = best_player_dices_moves->moves_by_dice

	// for each dices we apply the moves
	FOR(i;0;cst_nb_dices)
	
		// get move value
		move_value = moves_by_dice[i]
		
		// make the dice move by the value given
		// (it's either 1 or -1 depending of the move value sign, no other move value is allowed in the game)
		IF(move_value > 0)
			PRINT("MOVE 1")
		ELIF(move_value == 0)
			PRINT("MOVE 0")
		ELSE
			PRINT("MOVE -1")
		ENDIF

	ENDFOR

END

/**
 * This function check all objective that can be claimed,
 * - we keep the objective that is the more difficult to reach
 * - then make the player claim this objective
 *
 * (The more an objective is hard to reach to more point you get)
 */
FUNCTION make_claims()

	best_objective = NULL

	// Check all objectives !
	FOR(i;0;cst_nb_objectives)

		objective = objectives[i]

		// IF objective cannot be claimed OR is already claimed, continue to the next one
		IF(can_be_claimed(objective) == FALSE OR objective->is_claimed == TRUE)
			CONTINUE
		ENDIF

		// IF we have no other option, just set it to the best objective and continue
		IF(best_objective == NULL)
			best_objective = objective
			CONTINUE
		ENDIF

		// Compare both objective, if current object is better, set it as the best one !
		IF(best_objective->oid < objective->oid)
			best_objective = objective
		ENDIF
		
	ENDFOR

	// claim objective if we can !
	IF(best_objective != NULL)
		PRINT("CLAIM ", INT, best_objective->oid)
	ELSE
		PRINT("PASS")
	ENDIF

END

// --- ROUND FUNCTIONS ---

/**
 * Function that initiliaze the data at the start of each round
 */
FUNCTION start_round()

	update_players()
	update_objectives()

END

// --- TURN FUNCTIONS ---

/**
 * Make the player play this turn :
 * 
 * 1) We search the best moves to do this turn
 * 2) Then we apply theses moves on the game's dices
 * 3) Then we update the dices value (cause other player can also moves the dices)
 * 4) Then depending of the dices we claim the objectives
 */
FUNCTION play_turn()

	// get player ptr
	player = players[num_exp - 1]

	// Creating dices moves data
	best_player_dices_moves = get_best_dices_moves(player->dices)
	best_shared_dices_moves = create_dices_moves()

	// Getting objective
	targeted_objective = best_player_dices_moves->targeted_objective

	// Before computing the best moves for the shared_dices we must **ensure that we are targeting some objective** !
	// If there is no targeted_objective (cause all objective have been claimed)
	// -> Dont compute best moves for shared_dices
	IF (targeted_objective != NULL)

		// copy objective to simulate previous computed dices move on the current objective
		targeted_objective_copy = create_objective_copy(targeted_objective)
		apply_moves_on(targeted_objective_copy, best_player_dices_moves->moves_by_dice, player->dices)

		// get the best dices moves for the shared_dices for this objective
		get_best_dices_moves_for(targeted_objective_copy, shared_dices, best_shared_dices_moves)

		FREE(targeted_objective_copy)

	ENDIF

	// make moves that we computed before
	make_moves(best_shared_dices_moves, best_player_dices_moves)

	// update dice data
	update_dices()

	// make claims if possible
	make_claims()

	// free used data
	destroy_dices_moves_data(best_player_dices_moves)
	destroy_dices_moves_data(best_shared_dices_moves)

END

/**
 * Function used at the end of each turn.
 * it's only used to collect all players scores
 */
FUNCTION end_turn()

	update_scores()

END


/**
----------------------------------
            MAIN
----------------------------------
*/

FUNCTION main()

	// initilize script data (malloc & base values)
	init()

	PRINTERR("BOT MAXENCE ACTIVER :) \n")

	// While the game is running 
	WHILE(TRUE)

		start_round()

		// we play 6 turn for each round
		FOR(i;0;6)
			play_turn()
			end_turn()
		ENDFOR

	ENDWHILE

	// no need to free global game ptr,
	// they will be free when the programs stop
	// (or do i must free them to get more points ?)

END

