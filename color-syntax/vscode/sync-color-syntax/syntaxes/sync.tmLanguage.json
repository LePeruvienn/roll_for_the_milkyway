{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SYNC",
  "scopeName": "source.sync",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sync",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sync",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.todo.sync",
              "match": "\\b(TODO|FIXME|XXX|NOTE)\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sync",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sync",
          "match": "(?<![a-zA-Z_])-?\\d+(\\.\\d+)?(?![a-zA-Z_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sync",
          "match": "\\b(IF|ELSE|ELIF|ENDIF)\\b"
        },
        {
          "name": "keyword.control.sync",
          "match": "\\b(FOR|ENDFOR|WHILE|ENDWHILE)\\b"
        },
        {
          "name": "keyword.control.sync",
          "match": "\\b(RETURN|CONTINUE|BREAK)\\b"
        },
        {
          "name": "keyword.declaration.sync",
          "match": "\\b(FUNCTION|END)\\b"
        },
        {
          "name": "keyword.other.sync",
          "match": "\\b(STRUCT|ENDSTRUCT|GLOBALS|ENDGLOBALS)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.sync",
          "match": "\\b(INT|FLOAT|BOOL|CHAR)\\b"
        },
        {
          "name": "constant.language.boolean.sync",
          "match": "\\b(TRUE|FALSE)\\b"
        },
        {
          "name": "constant.language.null.sync",
          "match": "\\bNULL\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sync",
          "match": "\\b(PRINT|PRINTERR|MALLOC|MALLOC_STRUCT|FREE|READ)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sync",
          "match": "==|<=|>=|->|[=!+\\-*/<>%&|^~,;\\[\\]]|\\b(AND|OR|NOT)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.sync",
          "match": "\\bFUNCTION\\s+(?:\\w+\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "entity.name.function.call.sync",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sync",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.object.sync",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*->)"
        }
      ]
    }
  }
}

